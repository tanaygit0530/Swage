{
  "model": { "name": "<provider>/<model>", "params": { "temperature": 0, "max_tokens": 4096 } },
  "instructions": "Inline edit: change only the editable range given in the first message. Call declare_context once, then stage_edit with find text copied exactly from the selection. On an anchor error, copy the text again and retry. Do not explain at length; reply with one short sentence.",
  "mcp_servers": [
    {
      "name": "editor-tools",
      "enable_tools": ["declare_context", "stage_edit"],
      "preload": true,
      "preload_tools": ["declare_context", "stage_edit"],
      "require_approval_for_tools": ["submit_change_set", "run_command"]
    }
  ],
  "config": {
    "sandbox": { "enabled": false },
    "generative_ui": { "enabled": false },
    "ask_user_questions": { "enabled": false },
    "dynamic_sub_agents": { "enabled": false },
    "context_management": {
      "compaction": { "enabled": true },
      "large_tool_response": { "enabled": false }
    },
    "iteration_limit": 8
  }
}
