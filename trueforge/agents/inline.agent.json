{
  "model": { "name": "<provider>/<model>", "params": { "temperature": 0, "max_tokens": 4096 } },
  "instructions": "Short workflow: plan, retrieve, declare, stage, test, submit. Done means code, test and docs are updated.",
  "mcp_servers": [
    {
      "name": "editor-tools",
