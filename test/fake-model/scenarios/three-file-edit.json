{
  "name": "three-file-edit",
  "description": "Task B in miniature: find, read, declare, stage three files in one reply, run tests, submit.",
  "steps": [
    {
      "text": ["I'll ", "look for ", "the CLI code ", "first."],
      "chunkDelayMs": 40,
      "toolCalls": [
        {
          "name": "find_relevant_code",
          "arguments": {
            "query": "cli commands configuration"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "read_files",
          "arguments": {
            "files": [
              {
                "path": "app/cli.py"
              },
              {
                "path": "tests/test_cli.py"
              },
              {
                "path": "docs/cli.md"
              }
            ]
          }
        }
      ]
    },
    {
      "text": ["Plan: add the command, ", "test it, ", "document it."],
      "chunkDelayMs": 40,
      "toolCalls": [
        {
          "name": "declare_context",
          "arguments": {
            "plan": [
              "Add a config command that prints the configuration as JSON with secrets masked",
              "Cover it with a test",
              "Document it next to the other commands"
            ],
            "files": [
              {
                "path": "app/cli.py",
                "reason": "defines the built-in commands; the new config command goes here"
              },
              {
                "path": "tests/test_cli.py",
                "reason": "paired test file for app/cli.py"
              },
              {
                "path": "docs/cli.md",
                "reason": "documents the built-in commands"
              }
            ]
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "stage_edit",
          "arguments": {
            "path": "app/cli.py",
            "kind": "edit",
            "edits": [
              {
                "find": "    click.echo(\"/ /tasks /users\")\n",
                "replace": "    click.echo(\"/ /tasks /users\")\n\n\n@cli.command(\"config\")\ndef config_command():\n    \"\"\"Print the configuration as JSON, masking secret values.\"\"\"\n    import json\n\n    config = load_config()\n    masked = {\n        key: \"***\" if any(word in key.upper() for word in (\"SECRET\", \"PASSWORD\", \"TOKEN\", \"KEY\")) else value\n        for key, value in config.items()\n    }\n    click.echo(json.dumps(masked, default=str))\n"
              }
            ]
          }
        },
        {
          "name": "stage_edit",
          "arguments": {
            "path": "tests/test_cli.py",
            "kind": "edit",
            "edits": [
              {
                "find": "    assert \"/tasks\" in result.output\n",
                "replace": "    assert \"/tasks\" in result.output\n\n\ndef test_config_masks_secrets():\n    result = CliRunner().invoke(cli, [\"config\"])\n    assert '\"SECRET_KEY\": \"***\"' in result.output\n"
              }
            ]
          }
        },
        {
          "name": "stage_edit",
          "arguments": {
            "path": "docs/cli.md",
            "kind": "edit",
            "edits": [
              {
                "find": "Show the registered routes.\n",
                "replace": "Show the registered routes.\n\n## config\n\nPrint the configuration as JSON with secret values masked.\n"
              }
            ]
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "run_tests",
          "arguments": {
            "command": "npm test"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "submit_change_set",
          "arguments": {
            "summary": "Added a config command that prints the configuration as JSON with secrets masked, with a test and docs."
          }
        }
      ]
    },
    {
      "text": ["The change set ", "is ready ", "for your review."],
      "chunkDelayMs": 40
    }
  ]
}
