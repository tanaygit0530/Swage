{
  "name": "swage",
  "displayName": "Swage",
  "description": "An editor-native coding agent for VS Code whose agent loop runs on TrueForge.",
  "version": "0.0.1",
  "publisher": "swage-dev",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tanaygit0530/Swage.git"
  },
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.14.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "build": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "npm run build && tsc -p tsconfig.integration.json && node scripts/build-integration.mjs",
    "test:integration": "vscode-test",
    "package": "vsce package --no-dependencies",
    "setup": "node scripts/run.mjs scripts/setup.ts",
    "smoke": "node scripts/run.mjs scripts/smoke.ts",
    "fake-model": "node scripts/run.mjs scripts/fake-model.ts",
    "spike": "node scripts/run.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "swage.inlineEdit",
        "title": "Inline Edit",
        "category": "Swage"
      },
      {
        "command": "swage.openAgent",
        "title": "Open Agent",
        "category": "Swage"
      },
      {
        "command": "swage.stop",
        "title": "Stop",
        "category": "Swage"
      },
      {
        "command": "swage.reviewChanges",
        "title": "Review Changes",
        "category": "Swage"
      },
      {
        "command": "swage.undoLastChangeSet",
        "title": "Undo Last Change Set",
        "category": "Swage"
      },
      {
        "command": "swage.switchModel",
        "title": "Switch Model",
        "category": "Swage"
      },
      {
        "command": "swage.doctor",
        "title": "Doctor",
        "category": "Swage"
      },
      {
        "command": "swage.review.openFile",
        "title": "Open Diff",
        "category": "Swage",
        "icon": "$(diff)"
      },
      {
        "command": "swage.review.acceptBlock",
        "title": "Accept Block",
        "category": "Swage",
        "icon": "$(check)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.rejectBlock",
        "title": "Reject Block",
        "category": "Swage",
        "icon": "$(close)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.splitBlock",
        "title": "Split Block",
        "category": "Swage",
        "icon": "$(split-vertical)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.acceptFile",
        "title": "Accept All Blocks in File",
        "category": "Swage",
        "icon": "$(check-all)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.rejectFile",
        "title": "Reject All Blocks in File",
        "category": "Swage",
        "icon": "$(close-all)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.acceptAll",
        "title": "Accept All",
        "category": "Swage",
        "icon": "$(check-all)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.rejectAll",
        "title": "Reject All",
        "category": "Swage",
        "icon": "$(close-all)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.apply",
        "title": "Apply Accepted Blocks",
        "category": "Swage",
        "icon": "$(save-all)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.discard",
        "title": "Discard Change Set",
        "category": "Swage",
        "icon": "$(trash)",
        "enablement": "swage.reviewActive"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "swage.review.openFile",
          "when": "false"
        },
        {
          "command": "swage.review.acceptBlock",
          "when": "false"
        },
        {
          "command": "swage.review.rejectBlock",
          "when": "false"
        },
        {
          "command": "swage.review.splitBlock",
          "when": "false"
        },
        {
          "command": "swage.review.acceptFile",
          "when": "swage.reviewActive"
        },
        {
          "command": "swage.review.rejectFile",
          "when": "swage.reviewActive"
        },
        {
          "command": "swage.review.acceptAll",
          "when": "swage.reviewActive"
        },
        {
          "command": "swage.review.rejectAll",
          "when": "swage.reviewActive"
        },
        {
          "command": "swage.review.apply",
          "when": "swage.reviewActive"
        },
        {
          "command": "swage.review.discard",
          "when": "swage.reviewActive"
        }
      ],
      "view/title": [
        {
          "command": "swage.review.apply",
          "when": "view == swage.review && swage.reviewActive",
          "group": "navigation@0"
        },
        {
          "command": "swage.review.acceptAll",
          "when": "view == swage.review && swage.reviewActive",
          "group": "navigation@1"
        },
        {
          "command": "swage.review.rejectAll",
          "when": "view == swage.review && swage.reviewActive",
          "group": "navigation@2"
        },
        {
          "command": "swage.review.discard",
          "when": "view == swage.review && swage.reviewActive",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "swage.review.acceptFile",
          "when": "view == swage.review && viewItem == swage.review.file",
          "group": "inline@1"
        },
        {
          "command": "swage.review.rejectFile",
          "when": "view == swage.review && viewItem == swage.review.file",
          "group": "inline@2"
        },
        {
          "command": "swage.review.acceptBlock",
          "when": "view == swage.review && viewItem =~ /^swage\\.review\\.block\\.(pending|rejected)$/",
          "group": "inline@1"
        },
        {
          "command": "swage.review.rejectBlock",
          "when": "view == swage.review && viewItem =~ /^swage\\.review\\.block\\.(pending|accepted)$/",
          "group": "inline@2"
        },
        {
          "command": "swage.review.splitBlock",
          "when": "view == swage.review && viewItem =~ /^swage\\.review\\.block\\./",
          "group": "actions@1"
        }
      ],
      "editor/title": [
        {
          "command": "swage.review.acceptFile",
          "when": "resourceScheme == swage-staged && swage.reviewActive",
          "group": "navigation@1"
        },
        {
          "command": "swage.review.rejectFile",
          "when": "resourceScheme == swage-staged && swage.reviewActive",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "swage",
          "title": "Swage",
          "icon": "media/swage.svg"
        }
      ]
    },
    "views": {
      "swage": [
        {
          "type": "webview",
          "id": "swage.agentView",
          "name": "Agent"
        },
        {
          "id": "swage.review",
          "name": "Review"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "swage.review",
        "contents": "Nothing to review yet.\nWhen the agent submits a change set, its files and change blocks appear here. Nothing is written to disk until you apply.\n[Open the agent](command:swage.openAgent)"
      }
    ],
    "keybindings": [
      {
        "command": "swage.inlineEdit",
        "key": "ctrl+k ctrl+i",
        "mac": "cmd+k cmd+i",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "swage.stop",
        "key": "escape",
        "when": "swage.running"
      },
      {
        "command": "swage.stop",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "swage.running"
      }
    ],
    "configuration": {
      "title": "Swage",
      "properties": {
        "swage.models": {
          "type": "array",
          "markdownDescription": "Ordered model profiles. The first is the primary; the rest are fallbacks tried in order. Each profile names a TrueForge model only. API keys and provider URLs never go here; they live in TrueForge's own configuration (blueprint section 9).",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "name",
              "trueforgeModel"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Profile name, for example primary or fallback-1."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "hosted",
                  "local"
                ],
                "default": "hosted",
                "description": "Where the model runs."
              },
              "trueforgeModel": {
                "type": "string",
                "description": "The model identifier as configured in TrueForge, for example <provider>/<model>."
              },
              "params": {
                "type": "object",
                "properties": {
                  "temperature": {
                    "type": "number",
                    "default": 0
                  },
                  "max_tokens": {
                    "type": "integer",
                    "default": 4096
                  }
                }
              },
              "timeouts": {
                "type": "object",
                "properties": {
                  "connectMs": {
                    "type": "integer",
                    "default": 10000
                  },
                  "firstTokenMs": {
                    "type": "integer",
                    "default": 45000
                  },
                  "stallMs": {
                    "type": "integer",
                    "default": 30000
                  },
                  "totalMs": {
                    "type": "integer",
                    "default": 600000
                  }
                }
              }
            }
          }
        },
        "swage.budgets": {
          "type": "object",
          "markdownDescription": "Context token budgets (blueprint section 7). Tokens are estimated as characters divided by 4.",
          "default": {
            "repoMapTokens": 1500,
            "hintsFiles": 5,
            "hintsTokens": 1000,
            "toolResultTokens": 4000,
            "readsPerRunTokens": 30000
          },
          "properties": {
            "repoMapTokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Budget for the repository map."
            },
            "hintsFiles": {
              "type": "integer",
              "minimum": 0,
              "description": "Maximum number of files in the hints block."
            },
            "hintsTokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Budget for the hints block."
            },
            "toolResultTokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Budget for a single tool result before truncation."
            },
            "readsPerRunTokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Total full-file read budget per run."
            }
          }
        },
        "swage.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra glob patterns the agent must never read or edit, on top of `.gitignore`."
        },
        "swage.truefoundry.baseUrl": {
          "type": "string",
          "format": "uri",
          "default": "http://localhost:8790",
          "markdownDescription": "Base URL of the local TrueForge server."
        },
        "swage.autoStart": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Start TrueForge automatically when the extension activates."
        }
      }
    },
    "configurationDefaults": {
      "diffEditor.codeLens": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/shell-quote": "^1.7.5",
    "@types/vscode": "~1.96.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@truefoundry/trueforge-sdk": "0.184.1",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "diff": "^9.0.0",
    "ignore": "^7.0.14",
    "preact": "11.2.0",
    "shell-quote": "^1.12.0",
    "zod": "4.6.7"
  }
}
