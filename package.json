{
  "name": "swage",
  "displayName": "Swage",
  "description": "Editor-native coding agent for VS Code on TrueForge: inline edits and multi-file agent runs, reviewed block by block, with undo, cancellation and automatic model fallback.",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#C2401C",
    "theme": "dark"
  },
  "preview": true,
  "keywords": [
    "trueforge",
    "coding agent",
    "inline edit",
    "mcp",
    "diff review",
    "ai"
  ],
  "homepage": "https://github.com/tanaygit0530/Swage#readme",
  "bugs": {
    "url": "https://github.com/tanaygit0530/Swage/issues"
  },
  "version": "0.1.0",
  "publisher": "swage-dev",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tanaygit0530/Swage.git"
  },
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.14.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "build": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "npm run build && tsc -p tsconfig.integration.json && node scripts/build-integration.mjs",
    "test:integration": "vscode-test",
    "package": "vsce package --no-dependencies",
    "setup": "node scripts/run.mjs scripts/setup.ts",
    "smoke": "node scripts/run.mjs scripts/smoke.ts",
    "fake-model": "node scripts/run.mjs scripts/fake-model.ts",
    "spike": "node scripts/run.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "check:licences": "node scripts/licence-check.mjs",
    "break-primary": "node scripts/run.mjs scripts/break-primary.ts",
    "restore-primary": "node scripts/run.mjs scripts/restore-primary.ts",
    "add-ollama-model": "node scripts/run.mjs scripts/add-ollama-model.ts",
    "screenshots": "npm run build && node scripts/panel-shots/capture.mjs && node scripts/screenshots.mjs",
    "screenshots:panel": "npm run build && node scripts/panel-shots/capture.mjs",
    "rehearse:task-a": "SWAGE_FLASK_DIR=${SWAGE_FLASK_DIR:-../flask} SWAGE_REHEARSAL_PRINT=1 vitest run test/rehearsal/taskA.flask.test.ts",
    "rehearse:task-a:live": "SWAGE_LIVE=1 SWAGE_FLASK_DIR=${SWAGE_FLASK_DIR:-../flask} vitest run test/rehearsal/taskA.live.test.ts"
  },
  "contributes": {
    "commands": [
      {
        "command": "swage.inlineEdit",
        "title": "Inline Edit",
        "category": "Swage"
      },
      {
        "command": "swage.openAgent",
        "title": "Open Agent Panel",
        "category": "Swage"
      },
      {
        "command": "swage.stop",
        "title": "Stop Run",
        "category": "Swage"
      },
      {
        "command": "swage.reviewChanges",
        "title": "Review Changes",
        "category": "Swage"
      },
      {
        "command": "swage.undoLastChangeSet",
        "title": "Undo Last Change Set",
        "category": "Swage"
      },
      {
        "command": "swage.switchModel",
        "title": "Switch Model",
        "category": "Swage"
      },
      {
        "command": "swage.doctor",
        "title": "Doctor",
        "category": "Swage"
      },
      {
        "command": "swage.focusComposer",
        "title": "Focus Agent Composer",
        "category": "Swage"
      },
      {
        "command": "swage.review.openFile",
        "title": "Open Diff",
        "category": "Swage",
        "icon": "$(diff)"
      },
      {
        "command": "swage.review.acceptBlock",
        "title": "Accept Block",
        "category": "Swage",
        "icon": "$(check)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.rejectBlock",
        "title": "Reject Block",
        "category": "Swage",
        "icon": "$(close)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.splitBlock",
        "title": "Split Block",
        "category": "Swage",
        "icon": "$(split-vertical)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.acceptFile",
        "title": "Accept All Blocks in File",
        "category": "Swage",
        "icon": "$(check-all)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.rejectFile",
        "title": "Reject All Blocks in File",
        "category": "Swage",
        "icon": "$(close-all)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.acceptAll",
        "title": "Accept All",
        "category": "Swage",
        "icon": "$(check-all)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.rejectAll",
        "title": "Reject All",
        "category": "Swage",
        "icon": "$(close-all)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.apply",
        "title": "Apply Accepted Blocks",
        "category": "Swage",
        "icon": "$(save-all)",
        "enablement": "swage.reviewActive"
      },
      {
        "command": "swage.review.discard",
        "title": "Discard Change Set",
        "category": "Swage",
        "icon": "$(trash)",
        "enablement": "swage.reviewActive"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "swage.review.openFile",
          "when": "false"
        },
        {
          "command": "swage.review.acceptBlock",
          "when": "false"
        },
        {
          "command": "swage.review.rejectBlock",
          "when": "false"
        },
        {
          "command": "swage.review.splitBlock",
          "when": "false"
        },
        {
          "command": "swage.review.acceptFile",
          "when": "swage.reviewActive"
        },
        {
          "command": "swage.review.rejectFile",
          "when": "swage.reviewActive"
        },
        {
          "command": "swage.review.acceptAll",
          "when": "swage.reviewActive"
        },
        {
          "command": "swage.review.rejectAll",
          "when": "swage.reviewActive"
        },
        {
          "command": "swage.review.apply",
          "when": "swage.reviewActive"
        },
        {
          "command": "swage.review.discard",
          "when": "swage.reviewActive"
        }
      ],
      "view/title": [
        {
          "command": "swage.review.apply",
          "when": "view == swage.review && swage.reviewActive",
          "group": "navigation@0"
        },
        {
          "command": "swage.review.acceptAll",
          "when": "view == swage.review && swage.reviewActive",
          "group": "navigation@1"
        },
        {
          "command": "swage.review.rejectAll",
          "when": "view == swage.review && swage.reviewActive",
          "group": "navigation@2"
        },
        {
          "command": "swage.review.discard",
          "when": "view == swage.review && swage.reviewActive",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "swage.review.acceptFile",
          "when": "view == swage.review && viewItem == swage.review.file",
          "group": "inline@1"
        },
        {
          "command": "swage.review.rejectFile",
          "when": "view == swage.review && viewItem == swage.review.file",
          "group": "inline@2"
        },
        {
          "command": "swage.review.acceptBlock",
          "when": "view == swage.review && viewItem =~ /^swage\\.review\\.block\\.(pending|rejected)$/",
          "group": "inline@1"
        },
        {
          "command": "swage.review.rejectBlock",
          "when": "view == swage.review && viewItem =~ /^swage\\.review\\.block\\.(pending|accepted)$/",
          "group": "inline@2"
        },
        {
          "command": "swage.review.splitBlock",
          "when": "view == swage.review && viewItem =~ /^swage\\.review\\.block\\./",
          "group": "actions@1"
        }
      ],
      "editor/title": [
        {
          "command": "swage.review.acceptFile",
          "when": "resourceScheme == swage-staged && swage.reviewActive",
          "group": "navigation@1"
        },
        {
          "command": "swage.review.rejectFile",
          "when": "resourceScheme == swage-staged && swage.reviewActive",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "swage",
          "title": "Swage",
          "icon": "media/swage-icon.svg"
        }
      ]
    },
    "views": {
      "swage": [
        {
          "type": "webview",
          "id": "swage.agentView",
          "name": "Agent"
        },
        {
          "id": "swage.review",
          "name": "Review"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "swage.review",
        "contents": "Nothing to review yet.\nWhen the agent submits a change set, its files and change blocks appear here. Nothing is written to disk until you apply.\n[Open the agent](command:swage.openAgent)"
      }
    ],
    "keybindings": [
      {
        "command": "swage.focusComposer",
        "key": "ctrl+l",
        "mac": "cmd+l"
      },
      {
        "command": "swage.inlineEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "swage.stop",
        "key": "escape",
        "when": "swage.running"
      },
      {
        "command": "swage.stop",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "swage.running"
      }
    ],
    "configuration": {
      "title": "Swage",
      "properties": {
        "swage.models": {
          "type": "array",
          "markdownDescription": "Ordered model profiles. The first is the primary; the rest are fallbacks tried in order (blueprint section 8). Each profile names a TrueForge model only; API keys and provider URLs never go here, they live in TrueForge. When empty, a development checkout reads `config/models.yaml` (see `config/models.example.yaml`). Missing timeouts come from `kind`: hosted 10 s / 45 s / 30 s / 10 min, local 10 s / 120 s / 60 s / 15 min.",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "name",
              "trueforgeModel"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Profile name, for example primary or fallback-1.",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,39}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "hosted",
                  "local"
                ],
                "default": "hosted",
                "description": "Where the model runs."
              },
              "trueforgeModel": {
                "type": "string",
                "description": "The model identifier as configured in TrueForge, for example <provider>/<model>.",
                "pattern": "^[^/\\s]+/\\S+$"
              },
              "params": {
                "type": "object",
                "properties": {
                  "temperature": {
                    "type": "number",
                    "default": 0
                  },
                  "max_tokens": {
                    "type": "integer",
                    "default": 4096
                  }
                }
              },
              "timeouts": {
                "type": "object",
                "properties": {
                  "connectMs": {
                    "type": "integer",
                    "minimum": 100
                  },
                  "firstTokenMs": {
                    "type": "integer",
                    "minimum": 100
                  },
                  "stallMs": {
                    "type": "integer",
                    "minimum": 100
                  },
                  "totalMs": {
                    "type": "integer",
                    "minimum": 100
                  }
                },
                "description": "Per-attempt timers. Missing values come from kind: hosted connect 10 s, first token 45 s, stall 30 s, total 10 min; local 10 s, 120 s, 60 s, 15 min."
              },
              "label": {
                "type": "string",
                "maxLength": 40,
                "description": "Name shown in banners and the status bar, for example Gemini. Defaults to the provider part of trueforgeModel."
              },
              "inlineOnly": {
                "type": "boolean",
                "description": "Inline edits only: agent mode never starts on or falls back to this profile. Use it for a small local model (for example Ollama qwen2.5-coder:3b) that handles one selection well but not a multi-file task."
              }
            },
            "additionalProperties": false
          }
        },
        "swage.budgets": {
          "type": "object",
          "markdownDescription": "Context token budgets (blueprint section 7). Tokens are estimated as characters divided by 4.",
          "default": {
            "repoMapTokens": 1500,
            "hintsFiles": 5,
            "hintsTokens": 1000,
            "toolResultTokens": 4000,
            "readsPerRunTokens": 30000,
            "excerptTokens": 4000
          },
          "properties": {
            "repoMapTokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Budget for the repository map."
            },
            "hintsFiles": {
              "type": "integer",
              "minimum": 0,
              "description": "Maximum number of files in the hints block."
            },
            "hintsTokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Budget for the hints block."
            },
            "toolResultTokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Budget for a single tool result before truncation."
            },
            "readsPerRunTokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Total full-file read budget per run."
            },
            "excerptTokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Code excerpts of the top retrieved files sent with the request, so the agent needs fewer search and read calls. 0 sends none."
            }
          }
        },
        "swage.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra glob patterns the agent must never read or edit, on top of `.gitignore`."
        },
        "swage.truefoundry.baseUrl": {
          "type": "string",
          "format": "uri",
          "default": "http://localhost:8790",
          "markdownDescription": "Base URL of the local TrueForge server."
        },
        "swage.autoStart": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Start TrueForge automatically when the extension activates."
        },
        "swage.rateLimitWaitSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 120,
          "markdownDescription": "When a model is rate-limited and asks to retry within this many seconds (a free tier's per-minute quota), Swage waits on the same model and keeps the agent's context instead of switching models. `0` always switches at once."
        }
      }
    },
    "configurationDefaults": {
      "diffEditor.codeLens": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/shell-quote": "^1.7.5",
    "@types/vscode": "~1.96.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@truefoundry/trueforge-sdk": "0.184.1",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "diff": "^9.0.0",
    "ignore": "^7.0.14",
    "preact": "11.2.0",
    "shell-quote": "^1.12.0",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  }
}
